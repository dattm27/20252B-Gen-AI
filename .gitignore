.vscode
.claude
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Downloaded/fine-tuned model weights (large; regenerate with the Colab notebook)
models/

# Raw dataset (gated/licensed — download locally, do not commit)
data/raw/*
!data/raw/.gitkeep

# Processed splits (derived from the gated raw dataset — regenerate with scripts/split_dataset.py)
data/processed/*

# Generated results (baseline_metrics.json is committed as a record of the reported run)
results/*
!results/.gitkeep
!results/baseline_metrics.json
