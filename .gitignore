.vscode
.claude
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw dataset (gated/licensed — download locally, do not commit)
data/raw/*
!data/raw/.gitkeep

# Processed splits (derived from the gated raw dataset — regenerate with scripts/split_dataset.py)
data/processed/*

# Downloaded model checkpoints (large binaries — re-download from the Kaggle training run's Output tab)
models/*

# Generated results (these specific metrics files are committed as records of reported runs)
results/*
!results/.gitkeep
!results/baseline_metrics.json
!results/baseline_metrics_3class.json
!results/aste_baseline_metrics.json